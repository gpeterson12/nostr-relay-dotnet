<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Wipes out any inherited sources (e.g. any global sources configured on your machine) so 
         this repo only restores from nuget.org, regardless of what's configured machine-wide. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
